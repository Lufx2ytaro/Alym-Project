@page "/news"

<PageTitle>Новости — Alym</PageTitle>

<div class="container py-4">
    <h2 class="text-center mb-4 fw-bold text-primary">🗞️ Новости и обновления</h2>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <input type="text" class="form-control w-50 shadow-sm"
               placeholder="🔍 Поиск по новостям..."
               @bind="searchQuery"
               @bind:event="oninput" />

        <select class="form-select w-25 shadow-sm" @bind="selectedCategory">
            <option value="">Все категории</option>
            @foreach (var cat in categories)
            {
                <option value="@cat">@cat</option>
            }
        </select>
    </div>

    <div class="news-list">
        @foreach (var news in FilteredNews)
        {
            <div class="news-card p-4 mb-3 shadow-sm rounded bg-white">
                <h5 class="text-primary">@news.Title</h5>
                <small class="text-muted">@news.Category • @news.Date.ToShortDateString()</small>
                <p class="mt-2">@news.Preview</p>

                <button class="btn btn-outline-primary btn-sm" @onclick="() => selectedNews = news">
                    Читать далее
                </button>
            </div>
        }
    </div>

    @if (selectedNews != null)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.4);">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content p-4">
                    <h4 class="text-primary">@selectedNews.Title</h4>
                    <small class="text-muted">@selectedNews.Date.ToLongDateString()</small>
                    <hr />
                    <p>@selectedNews.Content</p>

                    <div class="text-end">
                        <button class="btn btn-secondary" @onclick="() => selectedNews = null">Закрыть</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<NewsItem> allNews = new();
    private NewsItem? selectedNews;
    private string searchQuery = string.Empty;
    private string selectedCategory = string.Empty;
    private List<string> categories = new() { "Налоги", "Бизнес", "Финансы", "Экономика", "Объявления" };

    protected override void OnInitialized()
    {
        allNews = new()
        {
            new NewsItem
        {
            Title = "Изменения в налоговом законодательстве 2025",
            Preview = "С 1 января вводятся новые ставки по УСН и ЕНВД...",
            Content = @"В рамках новой волны поддержки малого и среднего бизнеса, а также для дальнейшего стимулирования предпринимательской активности, государством были утверждены важные поправки в законодательство о налогообложении. Ключевые изменения касаются упрощенной системы налогообложения (УСН), которая является наиболее популярным налоговым режимом среди российских предпринимателей. Основная суть нововведений заключается в следующем: базовая ставка налога для объекта налогообложения «Доходы» в размере 6% остается неизменной, при этом порог годового дохода, позволяющий применять данный спецрежим, был существенно повышен — с ранее установленных 150 миллионов рублей до 250 миллионов рублей.

1. Сохранение ставки УСН 6%: Стабильность и предсказуемость
Решение оставить ставку налога на прежнем уровне является крайне важным сигналом для бизнеса. В условиях экономической неопределенности и изменчивой рыночной конъюнктуры стабильность налоговой нагрузки становится ключевым фактором для планирования и развития.

• Планируемость расходов: Компании и индивидуальные предприниматели, работающие на УСН «Доходы», могут с уверенностью строить свои финансовые модели и бизнес-планы на среднесрочную перспективу, зная, что их основная налоговая ставка не изменится.

• Снижение административного давления: Отсутствие необходимости пересчитывать налоговые обязательства, знакомиться с новыми формулами и правилами расчета позволяет сосредоточить ресурсы на основной деятельности, а не на адаптации к новым законодательным нормам.

• Поддержка микропредприятий и стартапов: Для начинающих предпринимателей и компаний с небольшими оборотами ставка в 6% остается одной из самых низких и привлекательных на рынке, что способствует созданию новых бизнесов и легализации доходов.

2. Повышение лимита дохода до 250 млн рублей: Расширение возможностей для роста
Повышение предельного размера доходов до 250 миллионов рублей в год — это наиболее значимое и долгожданное изменение для растущего бизнеса.

• «Дышащий» лимит для среднего бизнеса: Ранее многие успешные компании, перешагнувшие порог в 150 миллионов рублей, были вынуждены переходить на общую систему налогообложения (ОСНО), что влекло за собой резкое усложнение бухгалтерского и налогового учета, необходимость уплаты НДС и налога на прибыль. Теперь у таких компаний появляется гораздо больше «воздуха» для дальнейшего развития в рамках упрощенного режима.

• Стимул для развития без «налогового штрафа»: Предприниматели получают мощный стимул наращивать обороты, не опасаясь преждевременного «вылета» с комфортного налогового режима. Это позволяет реинвестировать больше средств в развитие, расширение штата, закупку оборудования и маркетинг.

• Сохранение конкурентного преимущества: Компании на УСН, не являющиеся плательщиками НДС, могут сохранять свои ценовые преимущества на рынке B2C (бизнес для потребителя) дольше, что особенно критично для секторов розничной торговли и услуг.

• Снижение количества вынужденных переходов на ОСНО: Данная мера позволит тысячам предприятий избежать сложного и зачастую затратного перехода на общую систему налогообложения, сохранив для них простоту и прозрачность УСН.

3. Комплексный эффект от изменений и практические рекомендации
В совокупности эти два изменения — сохранение ставки и повышение лимита — создают мощный синергетический эффект. Бизнес получает не только стабильность, но и пространство для маневра. Это прямой инструмент для стимулирования внутреннего валового продукта и поддержки отечественного производителя.

Рекомендации предпринимателям:
• Контроль лимитов: Несмотря на повышение порога по доходам, необходимо продолжать тщательно следить за всеми лимитами УСН
• Прозрачность учета: Вести своевременный и корректный учет всех доходов
• Консультация со специалистом: Оценить влияние изменений на вашу компанию

Таким образом, нововведения в упрощенной системе налогообложения являются взвешенной и своевременной мерой поддержки. Сохранение ставки 6% дает стабильность, а увеличение лимита до 250 млн рублей открывает новые горизонты для роста.",
            Category = "Налоги",
            Date = DateTime.Now.AddDays(-2)
        },
            new NewsItem
{
    Title = "Рост поддержки малого бизнеса",
    Preview = "Правительство запустило новые гранты для ИП...",
    Content = @"В рамках реализации национального проекта по развитию малого и среднего предпринимательства, Правительство Российской Федерации утвердило комплекс дополнительных мер поддержки, направленных на стимулирование бизнес-активности в регионах и создание благоприятных условий для старта и развития новых коммерческих проектов.

Основные направления поддержки:

1. Расширение программы грантовой поддержки
• Увеличение максимального размера гранта до 500 000 рублей для индивидуальных предпринимателей и микропредприятий
• Расширение перечня допустимых направлений использования средств: закупка оборудования, модернизация производства, разработка сайтов и маркетинг
• Упрощение процедуры подачи заявки через единый портал МСП

2. Льготное кредитование
• Снижение процентной ставки по кредитам для малого бизнеса до 6% годовых
• Увеличение срока кредитования до 5 лет для производственных предприятий
• Введение кредитных каникул для предпринимателей, пострадавших от сезонных колебаний спроса

3. Налоговые льготы и преференции
• Нулевая ставка по налогу на прибыль для вновь зарегистрированных ИП в течение первого года деятельности
• Освобождение от налога на имущество для производственных помещений малой площади
• Упрощенный порядок возмещения НДС для экспортно-ориентированных предприятий

4. Образовательные и консультационные программы
• Бесплатные курсы повышения квалификации по направлениям: цифровой маркетинг, финансовое планирование, управление персоналом
• Организация менторской поддержки от успешных предпринимателей с опытом работы более 10 лет
• Проведение региональных бизнес-форумов и нетворкинг-сессий

5. Инфраструктурная поддержка
• Создание коворкинг-центров в малых городах с бесплатным доступом для начинающих предпринимателей
• Предоставление субсидий на аренду торговых и производственных помещений
• Развитие промышленных парков и бизнес-инкубаторов в приоритетных регионах

Условия участия в программах:
• Регистрация в качестве ИП или юридического лица не позднее 1 года назад
• Отсутствие просроченной налоговой задолженности
• Наличие разработанного бизнес-плана или концепции проекта
• Соответствие деятельности приоритетным направлениям развития региона

Как подать заявку:
Подача документов осуществляется исключительно в электронной форме через официальный портал МСП (малыйбизнес.рф). Рассмотрение заявок занимает до 15 рабочих дней. Экспертная комиссия оценивает перспективность бизнес-идеи, финансовую устойчивость проекта и его потенциальное влияние на развитие региона.

Дополнительные преимущества:
Участники программ поддержки получают не только финансовую помощь, но и доступ к базе поставщиков, помощь в сертификации продукции, содействие в выходе на новые рынки сбыта.

Таким образом, комплекс мер государственной поддержки малого бизнеса направлен на создание устойчивой предпринимательской среды, снижение административных барьеров и стимулирование инновационной активности в ключевых секторах экономики.",
    Category = "Бизнес",
    Date = DateTime.Now.AddDays(-5)
            },
            new NewsItem
{
