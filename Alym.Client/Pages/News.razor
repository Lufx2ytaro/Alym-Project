Перспективы развития:
Ожидается, что при сохранении текущих тенденций рубль сохранит относительную стабильность в среднесрочной перспективе. Дальнейшая динамика будет зависеть от глобальных цен на энергоносители, геополитической обстановки и эффективности мер денежно-кредитного регулирования.

Таким образом, стабилизация курса рубля создает благоприятные условия для восстановления инвестиционной активности и долгосрочного экономического роста.",
    Category = "Экономика",
    Date = DateTime.Now.AddDays(-1)
}
        };
    }

    private IEnumerable<NewsItem> FilteredNews =>
        allNews
            .Where(n => (string.IsNullOrWhiteSpace(searchQuery) || n.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                     && (string.IsNullOrWhiteSpace(selectedCategory) || n.Category == selectedCategory))
            .OrderByDescending(n => n.Date);

    public class NewsItem
    {
        public string Title { get; set; } = string.Empty;
        public string Preview { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public DateTime Date { get; set; }
    }
}
