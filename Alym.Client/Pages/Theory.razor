        border-left: 4px solid #0d6efd;
    }

    .article-card:hover {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        background: #f8f9fa;
    }

    .fade-slide {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Общие стили для теории */
