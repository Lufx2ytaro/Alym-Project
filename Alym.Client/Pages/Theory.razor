        padding: 4px 12px;
        border-radius: 6px;
        font-weight: bold;
        margin-left: 5px;
    }

    .rentability .industry-table {
        display: grid;
        gap: 12px;
        margin: 20px 0;
    }

    .rentability .industry-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 20px;
        background: white;
        border: 1px solid #bdc3c7;
