    }

    .rentability .formula-block {
        display: grid;
        gap: 20px;
        margin: 25px 0;
    }

    .rentability .formula-item {
        background: white;
        border: 1px solid #e1e8ed;
        border-radius: 10px;
        padding: 25px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: transform 0.2s ease;
    }

    .rentability .formula-item:hover {
