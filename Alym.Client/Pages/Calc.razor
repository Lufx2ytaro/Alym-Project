@page "/calc"
@using Alym.Shared.Models

<PageTitle>Калькулятор — Alym</PageTitle>

<div class="container mt-3">
    <h3>Пошаговый мастер расчёта</h3>

    @if (step == 1)
    {
        <p>Выберите тип бизнеса:</p>
        <div class="d-flex flex-wrap">
            @foreach (var p in presets)
            {
                <button class="btn btn-outline-primary m-2" @onclick="() => SelectBusiness(p)">@p.Name</button>
            }
        </div>
    }
    else if (step == 2 && selected != null)
    {
        <h5>@selected.Name — Введите параметры</h5>

        <div class="card p-3 mb-3" style="max-width:800px">
    @for (int i = 0; i < selected.Questions.Count; i++)
    {
        var index = i;  <!-- фикс для Blazor -->
        <div class="mb-3">
            <label>@selected.Questions[index].Text</label>
            <InputNumber @bind-Value="selected.Questions[index].Value"
                         TValue="decimal"
                         class="form-control" />
        </div>
            }
            

            <div class="d-flex justify-content-between">
                <button class="btn btn-secondary" @onclick="Prev">← Назад</button>
                <button class="btn btn-primary" @onclick="Calculate">Посчитать →</button>
            </div>
        </div>
    }
    else if (step == 3)
    {
        <h5>Результаты</h5>
        <div class="card p-3" style="max-width:800px">
            @if (resultLines.Any())
            {
                <ul>
                    @foreach (var line in resultLines)
                    {
                        <li>@line</li>
                    }
                </ul>
            }
            else
            {
                <p>Результаты отсутствуют.</p>
            }

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-secondary" @onclick="() => { step = 1; selected = null; resultLines.Clear(); }">Начать заново</button>
                <button class="btn btn-outline-primary" @onclick="() => step = 2">Вернуться к параметрам</button>
            </div>
        </div>
    }
</div>

@code {
    private int step = 1;
    private BusinessPreset? selected;
    private List<BusinessPreset> presets = new();
    private List<string> resultLines = new();

    protected override void OnInitialized()
    {
        // Быстрые пресеты — можно потом загружать с сервера
        presets = new List<BusinessPreset>
        {
            new BusinessPreset
            {
                Name = "Кофейня",
                Questions = new List<Question>
                {
                    new Question { Text = "Сколько чашек в день?" },
                    new Question { Text = "Средний чек (руб)?" },
                    new Question { Text = "Себестоимость напитка (руб)?" },
                    new Question { Text = "Аренда в месяц (руб)?" }
                }
            },
            new BusinessPreset
            {
                Name = "Компьютерный клуб",
                Questions = new List<Question>
                {
                    new Question { Text = "Сколько компьютеров?" },
                    new Question { Text = "Часы работы в день (в среднем)?" },
                    new Question { Text = "Средняя цена за час (руб)?" },
                    new Question { Text = "Эл.энергия на 1 ПК/час (кВт·ч)?" },
                    new Question { Text = "Зарплата администратора в месяц (руб)?" }
                }
            },
            new BusinessPreset
            {
                Name = "Парикмахерская",
                Questions = new List<Question>
                {
                    new Question { Text = "Сколько мастеров?" },
                    new Question { Text = "Среднее количество клиентов в день на мастера?" },
                    new Question { Text = "Средний чек (руб)?" },
                    new Question { Text = "Расходы на материалы в месяц (руб)?" }
                }
            },
            new BusinessPreset
            {
              Name = "Общественный туалет",
              Questions = new List<Question>
              {
                new Question {Text = "Сколько стоит вход"},
                new Question {Text = "Среднее кол-во клиентов в день"},
                new Question {Text = "Расходы"},
              }
            }
        };
    }

    private void SelectBusiness(BusinessPreset p)
    {
        // создаём рабочую копию, чтобы не затронуть исходный шаблон
        selected = new BusinessPreset
        {
            Name = p.Name,
            Questions = p.Questions.Select(q => new Question { Text = q.Text, Value = 0m }).ToList()
        };
        step = 2;
    }

    private void Prev()
    {
        if (step > 1) step--;
    }

    private void Calculate()
    {
        resultLines.Clear();
        if (selected == null) return;

        // Примеры расчётов — замени на свои бухгалтерские формулы позже
        if (selected.Name == "Кофейня")
        {
            var cups = selected.Questions[0].Value;
            var avgCheck = selected.Questions[1].Value;
            var cost = selected.Questions[2].Value;
            var rent = selected.Questions[3].Value;

            var revenueDaily = cups * avgCheck;
            var profitDaily = cups * (avgCheck - cost);
            var profitMonthly = profitDaily * 26 - rent; // 26 рабочих дней — пример

            resultLines.Add($"Дневная выручка: {revenueDaily:0.00} руб.");
            resultLines.Add($"Дневная прибыль (после себестоимости): {profitDaily:0.00} руб.");
            resultLines.Add($"Приблизительная прибыль в месяц: {profitMonthly:0.00} руб.");
        }
        else if (selected.Name == "Компьютерный клуб")
        {
            var pcs = selected.Questions[0].Value;
            var hours = selected.Questions[1].Value;
            var priceHour = selected.Questions[2].Value;
            var elPerHour = selected.Questions[3].Value;
            var adminSalary = selected.Questions[4].Value;

            var revenueDaily = pcs * hours * priceHour;
            var dailyKwh = pcs * hours * elPerHour;

            resultLines.Add($"Дневная выручка: {revenueDaily:0.00} руб.");
            resultLines.Add($"Дневной расход электроэнергии: {dailyKwh:0.00} кВт·ч (умножьте на тариф для руб.)");
            resultLines.Add($"Зарплата администратора (в мес): {adminSalary:0.00} руб.");
        }
        else if (selected.Name == "Парикмахерская")
        {
            var masters = selected.Questions[0].Value;
            var clients = selected.Questions[1].Value;
            var avgCheck = selected.Questions[2].Value;
            var materials = selected.Questions[3].Value;

            var dailyClients = masters * clients;
            var revenueDaily = dailyClients * avgCheck;

            resultLines.Add($"Дневная выручка: {revenueDaily:0.00} руб.");
            resultLines.Add($"Материальные расходы в месяц: {materials:0.00} руб.");
        }
        else if(selected.Name == "Общественный туалет")
        {
          var price = selected.Questions[index:0].Value;
          var cl = selected.Questions[index:1].Value;
          var rashod = selected.Questions[index:2].Value;

          var den = price * cl - rashod;

          resultLines.Add(item: $"дневная выручка:{den:0.00} руб.");
        }

        step = 3;
    }
}
